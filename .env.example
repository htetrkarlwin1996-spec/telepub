APP_NAME=TeleMusic
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.paypal.com
MYANMYANPAY_APP_ID=
MYANMYANPAY_PUBLISHABLE_KEY=
MYANMYANPAY_SECRET_KEY=
MYANMYANPAY_API_BASE_URL=https://ezapi.myanmyanpay.com
# The SDK selects sandbox endpoints when the publishable or secret key contains _test_.
MYANMYANPAY_SANDBOX=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanelprefix_telemusic
DB_USERNAME=cpanelprefix_telemusic
DB_PASSWORD=CHANGE_TO_A_STRONG_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
RELEASE_AUDIO_DISK=public
RELEASE_AUDIO_MAX_MB=500
RELEASE_AUDIO_PREFIX=
RELEASE_AUDIO_DIRECT=false
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_EMAIL=info@telemusic.io

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RAPIDAPI_SPOTIFY_SCRAPER_KEY=
RAPIDAPI_SPOTIFY_SCRAPER_HOST=spotify-scraper.p.rapidapi.com
RAPIDAPI_SPOTIFY_SCRAPER_BASE_URL=https://spotify-scraper.p.rapidapi.com
